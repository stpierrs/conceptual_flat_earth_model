{
  "appId": "com.shanesmodel.flatearth",
  "appName": "Shane's Model 2.0",
  "webDir": ".",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0e121a"
  },
  "ios": {
    "backgroundColor": "#0e121a",
    "contentInset": "always"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0e121a",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
